<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.SobrePage"
             Title="Sobre">


    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Label 
            Text="Sobre o Aplicativo"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label 
            Text="Este aplicativo foi desenvolvido como atividade para o curso de Programação Mobile I."
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />

        <Line StrokeThickness="1" Stroke="Gray" />

        <Label 
            Text="Desenvolvido por:"
            FontSize="16"
            HorizontalOptions="Center" />

        <Label 
            Text="Israel Matheus" 
            FontSize="20"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label 
            Text="Ano de Desenvolvimento:"
            FontSize="16"
            HorizontalOptions="Center" 
            Margin="0,20,0,0"/>

        <Label 
            Text="2025" 
            FontSize="20"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>